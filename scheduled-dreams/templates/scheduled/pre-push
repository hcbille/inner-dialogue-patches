#!/usr/bin/env bash
# Push guard for the dream server's clone, installed as its .git/hooks/pre-push
# by install.sh. Only the scheduled runner (run.sh) pushes from that clone,
# and it sets DREAMER_RUNNER_PUSH=1 on its own git push; the dreamer agent
# never pushes there (.therapy/protocols/dream-ingest.md).
#
# Refuses: any push without DREAMER_RUNNER_PUSH=1; any ref other than main,
# dream/* and ingest/*; deleting any ref; a non-fast-forward to main.
# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
set -euo pipefail

refuse() { echo "pre-push (dreamer): refused: $*" >&2; exit 1; }

[ "${DREAMER_RUNNER_PUSH:-}" = "1" ] || refuse "only the scheduled runner pushes from this clone (DREAMER_RUNNER_PUSH is not 1)"

zero='^0+$'
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/dream/?*|refs/heads/ingest/?*) ;;
    *) refuse "$remote_ref is not main, dream/* or ingest/*" ;;
  esac
  if [[ "$local_sha" =~ $zero ]]; then
    refuse "deleting $remote_ref"
  fi
  if [ "$remote_ref" = "refs/heads/main" ] && ! [[ "$remote_sha" =~ $zero ]]; then
    git cat-file -e "${remote_sha}^{commit}" 2>/dev/null \
      || refuse "main on the remote is at a commit this clone doesn't have; fetch first"
    git merge-base --is-ancestor "$remote_sha" "$local_sha" \
      || refuse "non-fast-forward push to main"
  fi
done
exit 0
